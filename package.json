{
  "name": "decision-ledger",
  "private": true,
  "version": "0.1.0",
  "description": "Browser extension for recording code-review decisions across Git hosts",
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/adapters/*"
  ],
  "scripts": {
    "build": "npm run build -w @decision-ledger/core -w @decision-ledger/host-api -w @decision-ledger/adapter-github -w @decision-ledger/adapter-gitlab -w @decision-ledger/storage -w @decision-ledger/shell -w @decision-ledger/ui -w @decision-ledger/extension",
    "build:core": "npm run build -w @decision-ledger/core",
    "dev": "npm run dev -w @decision-ledger/extension",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED"
}
